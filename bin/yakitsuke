#!/bin/sh
[ -n "${ZSH_VERSION:-}" ] && emulate sh

for yk_inherited in $(env | sed -n 's/^\(YK_[A-Za-z0-9_]*\)=.*/\1/p'); do
  unset "${yk_inherited}"
done

yk_self="$0"
case "${yk_self}" in
*/*) ;;
*) yk_self="$(command -v -- "${yk_self}")" ;;
esac
YK_LIB="$(cd "${yk_self%/*}/../lib" && pwd)" || exit 1
YK_SHARE="$(cd "${yk_self%/*}/../share" && pwd)" || exit 1

# shellcheck source=SCRIPTDIR/../lib/core.sh
. "${YK_LIB}/core.sh"
# shellcheck source=SCRIPTDIR/../lib/ui.sh
. "${YK_LIB}/ui.sh"
# shellcheck source=SCRIPTDIR/../lib/cli.sh
. "${YK_LIB}/cli.sh"
# shellcheck source=SCRIPTDIR/../lib/args.sh
. "${YK_LIB}/args.sh"
# shellcheck source=SCRIPTDIR/../lib/probe.sh
. "${YK_LIB}/probe.sh"
# shellcheck source=SCRIPTDIR/../lib/geometry.sh
. "${YK_LIB}/geometry.sh"
# shellcheck source=SCRIPTDIR/../lib/plan.sh
. "${YK_LIB}/plan.sh"
# shellcheck source=SCRIPTDIR/../lib/subs.sh
. "${YK_LIB}/subs.sh"
# shellcheck source=SCRIPTDIR/../lib/encode.sh
. "${YK_LIB}/encode.sh"
# shellcheck source=SCRIPTDIR/../lib/image.sh
. "${YK_LIB}/image.sh"
# shellcheck source=SCRIPTDIR/../lib/run.sh
. "${YK_LIB}/run.sh"

yk_remove_tree() {
  yk_rt_try=0
  while ! rm -rf "$1" 2>/dev/null && [ "${yk_rt_try}" -lt 3 ]; do
    yk_rt_try=$((yk_rt_try + 1))
    sleep 1
  done
  [ ! -e "$1" ] || yk_warning "could not remove the working folder $1"
}

yk_cleanup() {
  [ -z "${YK_STAGE}" ] || yk_remove_tree "${YK_STAGE}"
  YK_STAGE=""
  [ -z "${YK_WORK}" ] || yk_remove_tree "${YK_WORK}"
  YK_WORK=""
}

yk_interrupted() {
  yk_cleanup
  exit 130
}

yk_ask() {
  if yk_ui_prompts; then
    yk_ui_header
  fi
  YK_INPUT="$(yk_ask_required "Video file" "no video given")" || return 1
  YK_SUBTITLES="$(yk_prompt "Subtitle file, Enter for none")" || return 1
}

yk_start() {
  yk_args_parse "$@" || return 1
  if [ -z "${YK_INPUT}" ]; then
    if ! yk_interactive; then
      yk_cli_hint "no video given"
      return 1
    fi
    yk_ask || return 1
  fi
  yk_args_validate || return 1
  YK_WORK="$(mktemp -d "${TMPDIR:-/tmp}/yakitsuke.XXXXXX")" || return 1
  trap yk_cleanup EXIT
  trap yk_interrupted INT TERM HUP
  yk_run
}

yk_main() {
  yk_mn_count=$#
  yk_mn_literal=no
  while [ "${yk_mn_count}" -gt 0 ]; do
    yk_mn_arg="$1"
    shift
    yk_mn_count=$((yk_mn_count - 1))
    case "${yk_mn_literal}:${yk_mn_arg}" in
    no:--) yk_mn_literal=yes ;;
    no:--theme=*)
      YK_THEME="${yk_mn_arg#--theme=}"
      continue
      ;;
    no:--theme)
      [ "${yk_mn_count}" -gt 0 ] || yk_main_stop "option '--theme' needs a value"
      YK_THEME="$1"
      shift
      yk_mn_count=$((yk_mn_count - 1))
      continue
      ;;
    *) ;;
    esac
    set -- "$@" "${yk_mn_arg}"
  done
  yk_ui_setup || yk_main_fail "${YK_UI_PROBLEM}"
  yk_dispatch "$@"
}

yk_main_stop() {
  yk_cli_hint "$1"
  exit 1
}

yk_main_fail() {
  yk_error "$1"
  exit 1
}

yk_dispatch() {
  case "${1:-}" in
  help | -h | --help) yk_usage ;;
  version | -V | --version) yk_cli_version ;;
  doctor) yk_doctor ;;
  *) yk_start "$@" ;;
  esac
}

yk_main "$@"
